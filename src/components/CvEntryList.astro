---
import type { CvEntry } from '../data/cv';
import { parsePath, t } from '../i18n/ui';

interface Props {
  entries: CvEntry[];
  compact?: boolean;
}

const { entries, compact = false } = Astro.props;
const { lang } = parsePath(Astro.url.pathname);
---

<ol class:list={['cv-list', { 'cv-list--compact': compact }]}>
  {entries.map((e) => (
    <li class="cv-item">
      <p class="cv-item__period">{t(e.period, lang)}</p>
      <div>
        <p class="cv-item__title">{t(e.title, lang)}</p>
        <p class="cv-item__org">
          {t(e.organization, lang)}
          {e.location && <span>, {t(e.location, lang)}</span>}
        </p>
        {e.details && e.details.length > 0 && (
          <ul class="cv-item__details">
            {e.details.map((d) => <li>{t(d, lang)}</li>)}
          </ul>
        )}
      </div>
    </li>
  ))}
</ol>

<style>
  .cv-list {
    list-style: none;
    display: grid;
    gap: var(--space-5);
  }

  .cv-list--compact {
    gap: var(--space-4);
  }

  .cv-item {
    display: grid;
    grid-template-columns: 9.5rem 1fr;
    gap: var(--space-1) var(--space-5);
  }

  .cv-list--compact .cv-item {
    grid-template-columns: 7.5rem 1fr;
  }

  .cv-item p {
    margin: 0;
  }

  .cv-item__period {
    color: var(--color-muted);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    padding-top: 0.1em;
  }

  .cv-item__title {
    color: var(--color-heading);
    font-weight: 600;
  }

  .cv-item__org {
    color: var(--color-text);
    font-size: var(--text-sm);
  }

  .cv-item__details {
    margin-top: var(--space-2);
    padding-left: 1.1rem;
    font-size: var(--text-sm);
  }

  @media (max-width: 36rem) {
    .cv-item,
    .cv-list--compact .cv-item {
      grid-template-columns: 1fr;
    }
  }
</style>
