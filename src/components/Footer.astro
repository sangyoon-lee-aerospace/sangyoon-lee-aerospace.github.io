---
import { affiliationLine, profile } from '../data/profile';
import { parsePath, t } from '../i18n/ui';

const { lang } = parsePath(Astro.url.pathname);
const year = new Date().getFullYear();
const name = t(profile.name, lang);
const owner = lang === 'ko' ? `${affiliationLine('ko')} ${name}` : `${name}, ${affiliationLine('en')}`;
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <p>© {year} {owner}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-8);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-xs);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    padding-block: var(--space-5);
  }

  .site-footer p {
    margin: 0;
  }
</style>
